<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AI Smart Study Planner</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- HEADER -->

    <header>
        <div class="logo">🎓 AI Study Planner</div>

        <nav>
            <a href="#home">Home</a>
            <a href="#planner">Planner</a>
            <a href="#dashboard">Dashboard</a>
        </nav>
    </header>


    <!-- HOME SECTION -->

    <section id="home" class="hero">

        <div class="hero-content">

            <h1>AI Smart Study Planner</h1>

            <p>
                Plan smarter. Study better. Achieve your goals.
            </p>

            <p class="small-text">
                Create a personalized study plan based on your
                subjects, exam dates and difficulty levels.
            </p>

            <button onclick="scrollToPlanner()">
                Create My Study Plan
            </button>

        </div>

    </section>


    <!-- PLANNER SECTION -->

    <section id="planner" class="planner-section">

        <h2>Create Your Study Plan</h2>

        <div class="planner-container">

            <!-- STUDENT DETAILS -->

            <div class="card">

                <h3>👤 Student Details</h3>

                <label>Student Name</label>

                <input type="text" id="studentName" placeholder="Enter your name">


                <label>Exam Date</label>

                <input type="date" id="examDate">


                <label>Study Hours Per Day</label>

                <input type="number" id="studyHours" placeholder="Example: 4" min="1" max="15">

            </div>


            <!-- SUBJECT DETAILS -->

            <div class="card">

                <h3>📚 Subject Details</h3>

                <p class="instruction">
                    Add your subjects and select their difficulty.
                </p>

                <div id="subjectsContainer">

                    <div class="subject-row">

                        <input type="text" class="subject-name" placeholder="Subject name">

                        <select class="difficulty">

                            <option value="Easy">
                                Easy
                            </option>

                            <option value="Medium" selected>
                                Medium
                            </option>

                            <option value="Hard">
                                Hard
                            </option>

                        </select>

                    </div>

                </div>


                <button class="add-btn" onclick="addSubject()">
                    + Add Subject
                </button>

            </div>


            <!-- GENERATE BUTTON -->

            <div class="generate-area">

                <button class="generate-btn" onclick="generatePlan()">
                    🤖 Generate AI Study Plan
                </button>

            </div>

        </div>

    </section>


    <!-- DASHBOARD -->

    <section id="dashboard" class="dashboard-section">

        <h2>📊 Your AI Study Dashboard</h2>

        <div id="welcomeMessage"></div>


        <!-- STATISTICS -->

        <div class="stats-container">

            <div class="stat-card">

                <h3 id="daysRemaining">
                    0
                </h3>

                <p>Days Remaining</p>

            </div>


            <div class="stat-card">

                <h3 id="totalSubjects">
                    0
                </h3>

                <p>Total Subjects</p>

            </div>


            <div class="stat-card">

                <h3 id="dailyHours">
                    0
                </h3>

                <p>Study Hours / Day</p>

            </div>


            <div class="stat-card">

                <h3 id="prioritySubject">
                    -
                </h3>

                <p>Priority Subject</p>

            </div>

        </div>


        <!-- AI RECOMMENDATION -->

        <div class="result-card">

            <h3>🤖 AI Recommendation</h3>

            <p id="aiRecommendation">
                Generate your study plan to receive recommendations.
            </p>

        </div>


        <!-- STUDY PLAN -->

        <div class="result-card">

            <h3>📅 Today's Study Plan</h3>

            <div id="studyPlan">

                <p>
                    Your personalized timetable will appear here.
                </p>

            </div>

        </div>


        <!-- SUBJECT PRIORITY -->

        <div class="result-card">

            <h3>🎯 Subject Priority</h3>

            <div id="subjectPriority">

                <p>
                    Generate your plan to see subject priorities.
                </p>

            </div>

        </div>


        <!-- PROGRESS -->

        <div class="result-card">

            <h3>📈 Study Progress</h3>

            <div class="progress-container">

                <div id="progressBar" class="progress-bar">
                    0%
                </div>

            </div>

        </div>

    </section>


    <!-- FOOTER -->

    <footer>

        <p>
            © 2026 AI Smart Study Planner
        </p>

        <p>
            Personalized learning powered by AI
        </p>

    </footer>


    <script src="script.js"></script>

</body>

</html>
